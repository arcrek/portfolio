---
import type { ProjectItem } from "../../data/projects";
import type { GitHubRepoMeta } from "../../lib/github";

interface Props {
  project: ProjectItem;
  ghMeta?: GitHubRepoMeta;
}

const { project, ghMeta } = Astro.props;
const primaryLang = ghMeta?.language ?? project.techStack[0] ?? "Python";
---

<details
  id={project.id}
  class="ed-project-row group border-b border-ed-border last:border-b-0 bg-ed-surface transition-colors"
>
  <summary class="px-4 sm:px-5 py-3.5 cursor-pointer select-none hover:bg-ed-surface-subtle/70 transition-colors flex flex-col md:flex-row md:items-center justify-between gap-2 md:gap-4">
    <!-- Left: Index + Title + 1-line summary -->
    <div class="flex items-center gap-3 min-w-0 flex-1">
      <span class="ed-row-chevron inline-flex items-center justify-center w-5 h-5 rounded-full border border-ed-border bg-ed-surface-subtle font-mono text-xs text-ed-text-muted transition-all duration-200 shrink-0">
        ▸
      </span>
      <span class="font-mono text-xs text-ed-text-muted shrink-0">
        {project.index}
      </span>
      <div class="min-w-0 flex-1 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3">
        <span class="font-mono text-sm font-bold text-ed-text group-hover:text-ed-accent transition-colors shrink-0">
          {project.title}
        </span>
        <span class="text-xs text-ed-text-secondary truncate">
          {project.tagline}
        </span>
      </div>
    </div>

    <!-- Right: Category + Stack Pills + Language -->
    <div class="flex items-center gap-2 pl-8 md:pl-0 shrink-0">
      <span class="hidden lg:inline-block font-mono text-[11px] text-ed-text-muted">
        {project.category}
      </span>

      <div class="flex items-center gap-1.5">
        {project.techStack.slice(0, 3).map((tech) => (
          <span class="rounded-md font-mono text-[10px] px-2 py-0.5 border border-ed-border bg-ed-surface-subtle/60 text-ed-text-secondary">
            {tech}
          </span>
        ))}
      </div>

      <span class="rounded-full font-mono text-[10px] px-2.5 py-0.5 bg-ed-accent-soft text-ed-accent border border-ed-accent-border font-medium">
        {primaryLang}
      </span>
    </div>
  </summary>

  <!-- Expanded Technical Notes -->
  <div class="ed-row-body px-4 sm:px-5 pb-5 pt-2 bg-ed-surface-subtle/40 border-t border-ed-border">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-2">
      <div class="space-y-1">
        <div class="font-mono text-[10px] font-semibold uppercase tracking-wider text-ed-text-muted">
          Problem & Motivation
        </div>
        <p class="text-xs text-ed-text-secondary leading-relaxed">
          {project.whyIBuiltThis}
        </p>
      </div>

      <div class="space-y-1">
        <div class="font-mono text-[10px] font-semibold uppercase tracking-wider text-ed-text-muted">
          System Mechanics
        </div>
        <p class="text-xs text-ed-text-secondary leading-relaxed">
          {project.howItWorks}
        </p>
      </div>

      <div class="space-y-1.5">
        <div class="font-mono text-[10px] font-semibold uppercase tracking-wider text-ed-accent">
          Engineering Highlights
        </div>
        <ul class="space-y-1">
          {project.keyHighlights.map((highlight) => (
            <li class="flex items-start gap-1.5 text-xs text-ed-text leading-relaxed">
              <span class="font-mono text-ed-status font-bold shrink-0">+</span>
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-4 pt-3 border-t border-ed-border flex flex-wrap items-center justify-between gap-3">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="font-mono text-[11px] text-ed-text-muted mr-1">Stack:</span>
        {project.techStack.map((tech) => (
          <span class="rounded-lg font-mono text-[11px] px-2 py-0.5 border border-ed-border bg-ed-surface text-ed-text-secondary">
            {tech}
          </span>
        ))}
      </div>

      <a
        href={project.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="m3-btn-expressive rounded-full inline-flex items-center gap-1.5 px-3.5 py-1 border border-ed-text bg-ed-text text-ed-bg font-mono text-xs font-medium hover:opacity-90"
      >
        <span>Inspect {project.repoSlug}</span>
        <span>↗</span>
      </a>
    </div>
  </div>
</details>

<script is:inline>
  function syncHashProjectRow() {
    if (!window.location.hash) return;
    const targetId = window.location.hash.slice(1);
    if (!targetId) return;
    const el = document.getElementById(targetId);
    if (el && el.tagName === "DETAILS") {
      el.setAttribute("open", "");
    }
  }

  if (!window.__edProjectRowBound) {
    window.__edProjectRowBound = true;
    syncHashProjectRow();
    window.addEventListener("hashchange", syncHashProjectRow);
    document.addEventListener("astro:page-load", syncHashProjectRow);
  }
</script>
