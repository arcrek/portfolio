---
import M3ThemeToggle from "./M3ThemeToggle.astro";
import M3SegmentedButton from "./M3SegmentedButton.astro";
import { PROFILE_INFO } from "../../data/projects";

interface Props {
  currentRoute?: "/" | "/lab" | "/services";
}

const { currentRoute = "/" } = Astro.props;
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-m3-surface/85 border-b border-m3-outline-variant/30 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between gap-4">
    <!-- Brand / Identity -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none focus-visible:ring-2 focus-visible:ring-m3-primary rounded-m3-md p-1">
      <div class="relative w-10 h-10 rounded-m3-full bg-m3-primary-container text-m3-on-primary-container flex items-center justify-center font-bold text-base shadow-xs group-hover:scale-105 transition-transform">
        <span>ND</span>
        <!-- Online pulse indicator -->
        <span class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 border-2 border-m3-surface rounded-full" title="ICT Student / Builder"></span>
      </div>
      <div class="hidden sm:block">
        <div class="text-sm font-bold text-m3-on-surface tracking-tight group-hover:text-m3-primary transition-colors">
          {PROFILE_INFO.name}
        </div>
        <div class="text-xs text-m3-on-surface-variant flex items-center gap-1.5 font-mono">
          <span>@{PROFILE_INFO.handle}</span>
          <span class="w-1 h-1 rounded-full bg-m3-outline-variant"></span>
          <span class="text-emerald-600 dark:text-emerald-400 font-sans font-medium">ICT Student / Builder</span>
        </div>
      </div>
    </a>

    <!-- Center: Persona Switcher (Desktop) -->
    <div class="hidden md:flex items-center justify-center">
      <M3SegmentedButton currentRoute={currentRoute} />
    </div>

    <!-- Actions / Utilities -->
    <div class="flex items-center gap-2">
      <!-- GitHub Profile Button -->
      <a
        href={PROFILE_INFO.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2.5 rounded-m3-full text-m3-on-surface-variant hover:text-m3-on-surface hover:bg-m3-surface-container active:bg-m3-surface-container-high transition-colors m3-state-layer"
        aria-label="View GitHub Profile"
        title="View GitHub Profile (@arcrek)"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- Direct Email Contact -->
      <a
        href={`mailto:${PROFILE_INFO.email}`}
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-m3-full text-xs font-medium text-m3-primary border border-m3-outline-variant hover:bg-m3-primary/8 transition-colors"
        title="Send direct email"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Contact</span>
      </a>

      <!-- Theme Switcher -->
      <M3ThemeToggle />
    </div>
  </div>

  <!-- Mobile Segmented Bar (Sticky sub-header for smaller viewports) -->
  <div class="md:hidden px-4 pb-3 flex justify-center bg-m3-surface/95 border-t border-m3-outline-variant/15 pt-2">
    <M3SegmentedButton currentRoute={currentRoute} class="w-full max-w-sm justify-center text-xs" />
  </div>
</header>
