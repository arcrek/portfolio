---
import Layout from "../layouts/Layout.astro";
import M3Card from "../components/m3/M3Card.astro";
import M3Button from "../components/m3/M3Button.astro";
import M3Chip from "../components/m3/M3Chip.astro";
import { CURATED_PROJECTS, PROFILE_INFO } from "../data/projects";
import { fetchAllCuratedRepos } from "../lib/github";

// Build-time GitHub data hydration
const repoSlugs = CURATED_PROJECTS.map((p) => p.repoSlug);
const githubMetaMap = await fetchAllCuratedRepos(repoSlugs);
---

<Layout currentRoute="/">
  <!-- Hero Section (Recruiter / Engineering Centered) -->
  <section class="py-6 sm:py-10">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="space-y-4 max-w-2xl">
        <!-- Status Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-m3-full bg-m3-surface-container-low border border-m3-outline-variant/50 text-xs font-medium text-m3-on-surface-variant shadow-2xs">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Open to Software Engineering & Systems Roles</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-m3-on-surface leading-tight">
          Hi, I'm <span class="text-m3-primary">{PROFILE_INFO.name}</span>.
        </h1>

        <p class="text-lg sm:text-xl text-m3-on-surface-variant font-medium leading-relaxed">
          {PROFILE_INFO.title}
        </p>

        <p class="text-sm sm:text-base text-m3-on-surface-variant/90 leading-relaxed">
          I build high-performance backend pipelines, resilient automation suites, and modern cloud infrastructure. Experienced in asynchronous event architectures, email protocols (Postfix/JMAP), and reliable reverse-engineered web automation.
        </p>

        <!-- CTA Action Row -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <M3Button href="#curated-projects" variant="filled">
            <svg slot="leading-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
            Explore Case Studies
          </M3Button>

          <M3Button href={PROFILE_INFO.githubUrl} target="_blank" variant="tonal">
            <svg slot="leading-icon" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            GitHub (@{PROFILE_INFO.handle})
          </M3Button>

          <M3Button href="/services" variant="outlined">
            <span>Looking for Client Services?</span>
            <svg slot="trailing-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </M3Button>
        </div>
      </div>

      <!-- Quick Metrics Grid Card -->
      <div class="w-full md:w-80 flex-shrink-0">
        <M3Card variant="elevated" padding="md" rounded="xl" class="border border-m3-outline-variant/30">
          <div class="text-xs font-semibold uppercase tracking-wider text-m3-primary mb-4 flex items-center justify-between">
            <span>Engineering Telemetry</span>
            <span class="w-2 h-2 rounded-full bg-m3-primary"></span>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div class="p-3 rounded-m3-lg bg-m3-surface-container">
              <div class="text-2xl font-extrabold text-m3-on-surface font-mono">{PROFILE_INFO.stats.publicRepos}</div>
              <div class="text-xs text-m3-on-surface-variant mt-0.5">Public Repos</div>
            </div>

            <div class="p-3 rounded-m3-lg bg-m3-surface-container">
              <div class="text-2xl font-extrabold text-m3-primary font-mono">{PROFILE_INFO.stats.hoursAutomated}</div>
              <div class="text-xs text-m3-on-surface-variant mt-0.5">Hours Saved</div>
            </div>

            <div class="p-3 rounded-m3-lg bg-m3-surface-container">
              <div class="text-2xl font-extrabold text-emerald-600 dark:text-emerald-400 font-mono">{PROFILE_INFO.stats.uptimeSLA}</div>
              <div class="text-xs text-m3-on-surface-variant mt-0.5">Uptime Target</div>
            </div>

            <div class="p-3 rounded-m3-lg bg-m3-surface-container">
              <div class="text-2xl font-extrabold text-m3-tertiary font-mono">{PROFILE_INFO.stats.codebasesShipped}</div>
              <div class="text-xs text-m3-on-surface-variant mt-0.5">Shipped Tools</div>
            </div>
          </div>

          <div class="mt-4 pt-3 border-t border-m3-outline-variant/30 flex items-center justify-between text-xs text-m3-on-surface-variant font-mono">
            <span>Location: {PROFILE_INFO.location}</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-semibold">Active Contributor</span>
          </div>
        </M3Card>
      </div>
    </div>
  </section>

  <!-- Technical Competencies & Architecture Matrix -->
  <section class="py-8 border-t border-m3-outline-variant/20">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface flex items-center gap-2">
        <svg class="w-6 h-6 text-m3-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
        </svg>
        <span>Technical Competencies & Core Stack</span>
      </h2>
      <p class="text-sm text-m3-on-surface-variant mt-1">
        Production technologies applied across real-world systems, automated pipelines, and cloud environments.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Backend Systems -->
      <M3Card variant="outlined" padding="sm" rounded="lg" class="hover:border-m3-primary/50 transition-colors">
        <div class="text-xs font-bold uppercase tracking-wider text-m3-primary mb-2 flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
          </svg>
          <span>Backend & Protocols</span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          {PROFILE_INFO.skills.backend.map((skill) => (
            <span class="text-xs px-2 py-0.5 rounded-m3-xs bg-m3-surface-container-high text-m3-on-surface font-mono">
              {skill}
            </span>
          ))}
        </div>
      </M3Card>

      <!-- Automation & RPA -->
      <M3Card variant="outlined" padding="sm" rounded="lg" class="hover:border-m3-primary/50 transition-colors">
        <div class="text-xs font-bold uppercase tracking-wider text-m3-tertiary mb-2 flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Automation & RPA</span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          {PROFILE_INFO.skills.automation.map((skill) => (
            <span class="text-xs px-2 py-0.5 rounded-m3-xs bg-m3-surface-container-high text-m3-on-surface font-mono">
              {skill}
            </span>
          ))}
        </div>
      </M3Card>

      <!-- Cloud & Infrastructure -->
      <M3Card variant="outlined" padding="sm" rounded="lg" class="hover:border-m3-primary/50 transition-colors">
        <div class="text-xs font-bold uppercase tracking-wider text-m3-secondary mb-2 flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" />
          </svg>
          <span>Cloud & DevOps</span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          {PROFILE_INFO.skills.cloudDevops.map((skill) => (
            <span class="text-xs px-2 py-0.5 rounded-m3-xs bg-m3-surface-container-high text-m3-on-surface font-mono">
              {skill}
            </span>
          ))}
        </div>
      </M3Card>

      <!-- Design & Interface -->
      <M3Card variant="outlined" padding="sm" rounded="lg" class="hover:border-m3-primary/50 transition-colors">
        <div class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-2 flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
          </svg>
          <span>Design Guidelines</span>
        </div>
        <div class="flex flex-wrap gap-1.5">
          {PROFILE_INFO.skills.designSystem.map((skill) => (
            <span class="text-xs px-2 py-0.5 rounded-m3-xs bg-m3-surface-container-high text-m3-on-surface font-mono">
              {skill}
            </span>
          ))}
        </div>
      </M3Card>
    </div>
  </section>

  <!-- Curated Engineering Case Studies -->
  <section id="curated-projects" class="py-10 border-t border-m3-outline-variant/20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-m3-primary mb-1">
          Deep-Dive Architecture
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-m3-on-surface">
          Featured Engineering Case Studies
        </h2>
        <p class="text-sm text-m3-on-surface-variant mt-1 max-w-2xl">
          Curated repositories showcasing system architecture, distributed protocol handling, and robust concurrency patterns. Data enriched at build-time from GitHub.
        </p>
      </div>

      <div class="flex items-center gap-2 text-xs text-m3-on-surface-variant font-mono">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Build Hydration: Live GitHub API</span>
      </div>
    </div>

    <!-- Case Studies Stack -->
    <div class="space-y-8">
      {CURATED_PROJECTS.map((project) => {
        const ghMeta = githubMetaMap[project.repoSlug];
        return (
          <M3Card variant="elevated" padding="lg" rounded="xl" class="border border-m3-outline-variant/40 hover:border-m3-primary/40 transition-colors">
            <!-- Header Row -->
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-m3-outline-variant/20">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs font-semibold px-2.5 py-0.5 rounded-m3-sm bg-m3-primary-container text-m3-on-primary-container">
                    {project.primaryCategory}
                  </span>
                  {project.featured && (
                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-m3-sm bg-m3-tertiary-container text-m3-on-tertiary-container">
                      ★ Key Architecture
                    </span>
                  )}
                  <span class="text-xs font-mono text-m3-on-surface-variant/80">
                    {project.repoSlug}
                  </span>
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-m3-on-surface">
                  {project.title}
                </h3>
                <p class="text-sm text-m3-on-surface-variant">
                  {project.tagline}
                </p>
              </div>

              <!-- GitHub Stats Pills -->
              <div class="flex items-center gap-3 self-start lg:self-center">
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container text-xs font-mono text-m3-on-surface">
                  <svg class="w-3.5 h-3.5 text-amber-500 fill-amber-500" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  <span>{ghMeta?.stars ?? 0}</span>
                </div>

                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-m3-full bg-m3-surface-container text-xs font-mono text-m3-on-surface">
                  <span class="w-2 h-2 rounded-full bg-m3-primary"></span>
                  <span>{ghMeta?.language ?? "Python"}</span>
                </div>

                <a
                  href={project.recruiterView.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 px-3 py-1 rounded-m3-full bg-m3-secondary-container text-m3-on-secondary-container text-xs font-medium hover:bg-m3-secondary-container/80 transition-colors"
                >
                  <span>Code</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </div>
            </div>

            <!-- Deep-Dive Content Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6">
              <!-- Left: Problem & Architecture -->
              <div class="space-y-4">
                <div>
                  <h4 class="text-xs font-bold uppercase tracking-wider text-m3-error dark:text-red-400 mb-1 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    <span>The Engineering Problem</span>
                  </h4>
                  <p class="text-sm text-m3-on-surface-variant leading-relaxed">
                    {project.recruiterView.problemStatement}
                  </p>
                </div>

                <div>
                  <h4 class="text-xs font-bold uppercase tracking-wider text-m3-primary mb-1 flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    <span>System Architecture & Solution</span>
                  </h4>
                  <p class="text-sm text-m3-on-surface-variant leading-relaxed">
                    {project.recruiterView.architectureSolution}
                  </p>
                </div>
              </div>

              <!-- Right: Key Architectural Decisions & Metrics -->
              <div class="space-y-4 bg-m3-surface-container-low/70 p-4 rounded-m3-lg border border-m3-outline-variant/30">
                <div>
                  <h4 class="text-xs font-bold uppercase tracking-wider text-m3-secondary mb-2">
                    Key Implementation Decisions
                  </h4>
                  <ul class="space-y-2">
                    {project.recruiterView.keyTechnicalDecisions.map((decision) => (
                      <li class="flex items-start gap-2 text-xs text-m3-on-surface">
                        <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                        <span>{decision}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Verified Performance Highlights -->
                <div class="pt-2 border-t border-m3-outline-variant/20">
                  <div class="text-xs font-semibold text-m3-on-surface-variant mb-2">
                    Telemetry & Performance:
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {project.recruiterView.performanceHighlights.map((highlight) => (
                      <span class="text-xs px-2.5 py-1 rounded-m3-sm bg-m3-surface-container text-m3-primary font-mono font-medium">
                        {highlight}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Footer: Tech Stack Chips -->
            <div class="mt-6 pt-4 border-t border-m3-outline-variant/20 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap items-center gap-1.5">
                <span class="text-xs text-m3-on-surface-variant font-medium mr-1">Stack:</span>
                {project.techStack.map((tech) => (
                  <M3Chip variant="assist">
                    {tech}
                  </M3Chip>
                ))}
              </div>

              <div class="flex items-center gap-2">
                <a
                  href={`/services#${project.id}`}
                  class="text-xs font-medium text-m3-tertiary hover:underline inline-flex items-center gap-1"
                >
                  <span>See business ROI for clients</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </M3Card>
        );
      })}
    </div>
  </section>

  <!-- GitHub Secondary Repositories & Open Source Archive -->
  <section class="py-10 border-t border-m3-outline-variant/20">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-m3-on-surface">
          More from @{PROFILE_INFO.handle} on GitHub
        </h2>
        <p class="text-sm text-m3-on-surface-variant">
          Additional utility tools, automation scripts, and exploratory codebases.
        </p>
      </div>

      <M3Button href={PROFILE_INFO.githubUrl} target="_blank" variant="outlined">
        <span>View all {PROFILE_INFO.stats.publicRepos} Repositories</span>
        <svg slot="trailing-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </M3Button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <M3Card variant="outlined" padding="sm" rounded="lg" class="flex flex-col justify-between hover:border-m3-primary/50 transition-colors">
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm font-bold text-m3-on-surface font-mono">Restaurant_Management_System</span>
            <span class="text-xs px-2 py-0.5 rounded-m3-xs bg-m3-surface-container font-mono">UML</span>
          </div>
          <p class="text-xs text-m3-on-surface-variant mt-2 leading-relaxed">
            Restaurant management concept & UML system designs for kitchen ordering, inventory management, and multi-station reporting.
          </p>
        </div>
        <div class="mt-4 pt-2 border-t border-m3-outline-variant/20 flex items-center justify-between text-xs">
          <span class="text-m3-on-surface-variant">Systems Design</span>
          <a href="https://github.com/arcrek/Restaurant_Management_System" target="_blank" rel="noopener noreferrer" class="text-m3-primary font-medium hover:underline">
            Inspect repo &rarr;
          </a>
        </div>
      </M3Card>

      <M3Card variant="outlined" padding="sm" rounded="lg" class="flex flex-col justify-between hover:border-m3-primary/50 transition-colors">
        <div>
          <div class="flex items-center justify-between gap-2">
            <span class="text-sm font-bold text-m3-on-surface font-mono">2D_Doodle_Jump_Web_Project</span>
            <span class="text-xs px-2 py-0.5 rounded-m3-xs bg-m3-surface-container font-mono">JavaScript</span>
          </div>
          <p class="text-xs text-m3-on-surface-variant mt-2 leading-relaxed">
            HTML5 Canvas physics game engine recreation featuring kinematic jumps, platform collision detection, and high-score state tracking.
          </p>
        </div>
        <div class="mt-4 pt-2 border-t border-m3-outline-variant/20 flex items-center justify-between text-xs">
          <span class="text-m3-on-surface-variant">Canvas / Game Dev</span>
          <a href="https://github.com/arcrek/2D_Doodle_Jump_Web_Project" target="_blank" rel="noopener noreferrer" class="text-m3-primary font-medium hover:underline">
            Inspect repo &rarr;
          </a>
        </div>
      </M3Card>

      <M3Card variant="outlined" padding="sm" rounded="lg" class="flex flex-col justify-between hover:border-m3-primary/50 transition-colors">
        <div>
          <div class="flex items-center justify-between gap-2">
