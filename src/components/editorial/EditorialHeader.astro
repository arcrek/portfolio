---
import ThemeToggle from "./ThemeToggle.astro";
import { PROFILE_INFO } from "../../data/projects";

interface Props {
  currentRoute?: "/" | "/lab" | "/services";
}

const { currentRoute = "/" } = Astro.props;
const isHome = currentRoute === "/";
const isLab = currentRoute === "/lab" || currentRoute === "/services";
---

<header class="sticky top-0 z-50 w-full bg-ed-bg/90 backdrop-blur-md border-b border-ed-border">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">
    <!-- Brand / Identity -->
    <a
      href={import.meta.env.BASE_URL}
      class="inline-flex items-center gap-2.5 group focus:outline-none"
    >
      <span class="font-mono text-sm font-semibold tracking-tight text-ed-text group-hover:text-ed-accent transition-colors">
        @{PROFILE_INFO.handle}
      </span>
      <span class="text-ed-border-strong font-mono text-xs">/</span>
      <span class="hidden sm:inline text-xs font-mono text-ed-text-muted">
        {PROFILE_INFO.name}
      </span>
    </a>

    <!-- Navigation & Actions -->
    <div class="flex items-center gap-2 sm:gap-4">
      <nav aria-label="Primary navigation" class="flex items-center gap-0.5 rounded-full border border-ed-border bg-ed-surface-subtle p-1">
        <a
          href={import.meta.env.BASE_URL}
          aria-current={isHome ? "page" : undefined}
          class={`m3-btn-expressive px-3 py-1 rounded-full text-xs font-mono ${
            isHome
              ? "bg-ed-text text-ed-bg font-semibold shadow-2xs"
              : "text-ed-text-secondary hover:text-ed-text hover:bg-ed-surface/80"
          }`}
        >
          <span class="opacity-60 mr-1">01</span>Index
        </a>
        <a
          href={`${import.meta.env.BASE_URL}lab`}
          aria-current={isLab ? "page" : undefined}
          class={`m3-btn-expressive px-3 py-1 rounded-full text-xs font-mono inline-flex items-center gap-1.5 ${
            isLab
              ? "bg-ed-text text-ed-bg font-semibold shadow-2xs"
              : "text-ed-text-secondary hover:text-ed-text hover:bg-ed-surface/80"
          }`}
        >
          <span><span class="opacity-60 mr-1">02</span>Lab</span>
          <span
            class={`rounded-full text-[10px] px-1.5 py-px uppercase tracking-wider border ${
              isLab
                ? "border-ed-bg/30 text-ed-bg/90"
                : "border-ed-border bg-ed-surface text-ed-text-muted"
            }`}
          >
            Hobby
          </span>
        </a>
      </nav>

      <div class="h-4 w-px bg-ed-border hidden sm:block"></div>

      <div class="flex items-center gap-1.5">
        <a
          href={PROFILE_INFO.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="m3-btn-expressive inline-flex items-center justify-center w-8 h-8 rounded-full border border-ed-border bg-ed-surface-subtle/70 text-ed-text-secondary hover:text-ed-text hover:bg-ed-surface-muted/70 hover:border-ed-border-strong"
          aria-label="GitHub profile"
          title={`GitHub (@${PROFILE_INFO.handle})`}
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            />
          </svg>
        </a>

        <a
          href={`mailto:${PROFILE_INFO.email}`}
          class="m3-btn-expressive hidden sm:inline-flex items-center gap-1.5 h-8 px-3 rounded-full border border-ed-border bg-ed-surface-subtle/70 text-xs font-mono text-ed-text-secondary hover:text-ed-text hover:bg-ed-surface-muted/70 hover:border-ed-border-strong"
          title="Send email"
        >
          <span>Email</span>
          <span class="text-ed-accent">↗</span>
        </a>

        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
