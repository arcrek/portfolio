---
interface Props {
  currentRoute: "/" | "/lab" | "/services";
  class?: string;
}

const { currentRoute = "/", class: className = "" } = Astro.props;

const isProjects = currentRoute === "/" || currentRoute === "/recruiter";
const isLab = currentRoute === "/lab" || currentRoute === "/services";
---

<nav aria-label="Section selector" class={`inline-flex items-center p-1 bg-m3-surface-container-low border border-m3-outline-variant/60 rounded-m3-full shadow-xs ${className}`}>
  <!-- Projects & Builds Option -->
  <a
    href={import.meta.env.BASE_URL}
    class={`flex items-center gap-2 px-5 py-2 text-sm font-medium rounded-l-m3-full rounded-r-m3-xs transition-all duration-200 select-none ${
      isProjects
        ? "bg-m3-secondary-container text-m3-on-secondary-container font-semibold shadow-xs"
        : "text-m3-on-surface-variant hover:text-m3-on-surface hover:bg-m3-surface-container"
    }`}
  >
    {isProjects ? (
      <svg class="w-4 h-4 text-m3-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    ) : (
      <svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
      </svg>
    )}
    <span>Projects & Builds</span>
  </a>

  <div class="w-px h-5 bg-m3-outline-variant/50 self-center"></div>

  <!-- Homelab & Journey Option -->
  <a
    href={`${import.meta.env.BASE_URL}lab`}
    class={`flex items-center gap-2 px-5 py-2 text-sm font-medium rounded-r-m3-full rounded-l-m3-xs transition-all duration-200 select-none ${
      isLab
        ? "bg-m3-secondary-container text-m3-on-secondary-container font-semibold shadow-xs"
        : "text-m3-on-surface-variant hover:text-m3-on-surface hover:bg-m3-surface-container"
    }`}
  >
    {isLab ? (
      <svg class="w-4 h-4 text-m3-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    ) : (
      <svg class="w-4 h-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
      </svg>
    )}
    <span>Homelab & Journey</span>
  </a>
</nav>
