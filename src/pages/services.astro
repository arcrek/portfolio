---
import Layout from "../layouts/Layout.astro";
import M3Card from "../components/m3/M3Card.astro";
import M3Button from "../components/m3/M3Button.astro";
import M3Chip from "../components/m3/M3Chip.astro";
import { CURATED_PROJECTS, PROFILE_INFO } from "../data/projects";
---

<Layout
  currentRoute="/services"
  title={`Client & Automation Services — ${PROFILE_INFO.name}`}
  description="Custom backend automation systems, cloud workflow orchestration, and high-reliability data pipelines for founders and growth teams."
>
  <!-- Hero Section (Client & Business Centered) -->
  <section class="py-6 sm:py-10">
    <div class="max-w-3xl space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-m3-full bg-m3-tertiary-container text-xs font-semibold text-m3-on-tertiary-container shadow-2xs">
        <svg class="w-3.5 h-3.5 text-m3-tertiary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Automation Consulting & Contract Systems Engineering</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-m3-on-surface leading-tight">
        Save <span class="text-m3-primary">20+ Engineering Hours</span> Every Week Through Custom Automation.
      </h1>

      <p class="text-lg text-m3-on-surface-variant leading-relaxed">
        I design, build, and deploy turnkey backend systems, cloud task automations, and resilient webhook pipelines for companies that have outgrown fragile no-code tools and expensive SaaS subscriptions.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <M3Button href={`mailto:${PROFILE_INFO.email}?subject=Automation%20Consultation%20Inquiry`} variant="filled">
          <svg slot="leading-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          Request an Automation Consultation
        </M3Button>

        <M3Button href="#service-packages" variant="tonal">
          <span>Explore Service Capabilities</span>
        </M3Button>

        <M3Button href="/" variant="outlined">
          <svg slot="leading-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Switch to Recruiter View</span>
        </M3Button>
      </div>
    </div>
  </section>

  <!-- Value Pillars -->
  <section class="py-8 border-t border-m3-outline-variant/20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <M3Card variant="elevated" padding="md" rounded="lg" class="border border-m3-outline-variant/40">
        <div class="w-10 h-10 rounded-m3-full bg-m3-primary-container text-m3-on-primary-container flex items-center justify-center mb-3">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-m3-on-surface">You Own 100% of the Code</h3>
        <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-2 leading-relaxed">
          Zero per-seat licensing, no proprietary vendor lock-in. Everything is deployed directly to your private cloud (GCP, AWS, Docker, or Cloudflare) with full source code.
        </p>
      </M3Card>

      <M3Card variant="elevated" padding="md" rounded="lg" class="border border-m3-outline-variant/40">
        <div class="w-10 h-10 rounded-m3-full bg-m3-secondary-container text-m3-on-secondary-container flex items-center justify-center mb-3">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-m3-on-surface">Resilient Automation Architecture</h3>
        <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-2 leading-relaxed">
          No fragile browser clicks that break on minor UI updates. Built with direct API integration, idempotency keys, automatic backoff retries, and instant Telegram/Slack alert webhooks.
        </p>
      </M3Card>

      <M3Card variant="elevated" padding="md" rounded="lg" class="border border-m3-outline-variant/40">
        <div class="w-10 h-10 rounded-m3-full bg-m3-tertiary-container text-m3-on-tertiary-container flex items-center justify-center mb-3">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-base font-bold text-m3-on-surface">Immediate Business ROI</h3>
        <p class="text-xs sm:text-sm text-m3-on-surface-variant mt-2 leading-relaxed">
          Turn hours of repetitive daily administration into background jobs that execute in milliseconds. Fast turnarounds with clear milestones and comprehensive documentation.
        </p>
      </M3Card>
    </div>
  </section>

  <!-- Service Offerings & Proven Case Studies -->
  <section id="service-packages" class="py-10 border-t border-m3-outline-variant/20">
    <div class="mb-8">
      <div class="text-xs font-bold uppercase tracking-wider text-m3-primary mb-1">
        What I Deliver
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-m3-on-surface">
        Specialized Engineering Services
      </h2>
      <p class="text-sm text-m3-on-surface-variant mt-1 max-w-2xl">
        Each engagement is built around concrete business problems, validated through real-world client implementations.
      </p>
    </div>

    <div class="space-y-8">
      {CURATED_PROJECTS.map((project) => (
        <M3Card id={project.id} variant="elevated" padding="lg" rounded="xl" class="border border-m3-outline-variant/40">
          <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
            <!-- Left: Solution Description -->
            <div class="space-y-4 max-w-2xl">
              <div class="flex flex-wrap items-center gap-2">
                <span class="text-xs font-bold px-2.5 py-0.5 rounded-m3-sm bg-m3-secondary-container text-m3-on-secondary-container">
                  {project.primaryCategory}
                </span>
                <span class="text-xs font-semibold px-2.5 py-0.5 rounded-m3-sm bg-emerald-100 text-emerald-900 dark:bg-emerald-950 dark:text-emerald-300">
                  ROI: {project.servicesView.roiImpact}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-m3-on-surface">
                {project.title}
              </h3>

              <div class="space-y-3 text-sm text-m3-on-surface-variant">
                <div>
                  <strong class="text-m3-on-surface font-semibold">The Pain Point:</strong> {project.servicesView.businessProblem}
                </div>
                <div>
                  <strong class="text-m3-primary font-semibold">The Solution:</strong> {project.servicesView.solutionDelivered}
                </div>
              </div>

              <!-- Use cases list -->
              <div class="pt-2">
                <div class="text-xs font-bold uppercase tracking-wider text-m3-on-surface mb-2">
                  Common Business Use Cases:
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  {project.servicesView.useCases.map((useCase) => (
                    <div class="flex items-center gap-2 text-xs text-m3-on-surface-variant bg-m3-surface-container-low p-2 rounded-m3-sm border border-m3-outline-variant/30">
                      <svg class="w-3.5 h-3.5 text-m3-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{useCase}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Right: Deliverables Card -->
            <div class="w-full lg:w-72 flex-shrink-0 bg-m3-surface-container-low p-5 rounded-m3-lg border border-m3-outline-variant/30 space-y-4">
              <div class="text-xs font-bold uppercase tracking-wider text-m3-tertiary">
                Package Deliverables
              </div>

              <ul class="space-y-2.5">
                {project.servicesView.deliverables.map((item) => (
                  <li class="flex items-start gap-2 text-xs text-m3-on-surface">
                    <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <div class="pt-3 border-t border-m3-outline-variant/20">
                <M3Button href={`mailto:${PROFILE_INFO.email}?subject=${encodeURIComponent(`Inquiry: ${project.title}`)}`} variant="filled" class="w-full text-xs py-2">
                  Inquire About This Service
                </M3Button>
              </div>
            </div>
          </div>
        </M3Card>
      ))}
    </div>
  </section>

  <!-- Client Consultation Callout Banner -->
  <section class="my-10 border-t border-m3-outline-variant/20 pt-8">
    <M3Card variant="filled" padding="lg" rounded="xl" class="bg-m3-primary-container text-m3-on-primary-container">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <div class="text-xs font-bold uppercase tracking-wider text-m3-primary">
            Ready to Automate Your Workflow?
          </div>
          <h3 class="text-2xl font-bold">
            Get in touch for scoping and feasibility.
          </h3>
          <p class="text-sm opacity-90 leading-relaxed">
            Reach out directly via email to discuss project requirements, architecture scoping, and turnaround timelines.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <M3Button href={`mailto:${PROFILE_INFO.email}?subject=Project%20Inquiry%20-%20Automation%20Services`} variant="filled" class="bg-m3-primary text-m3-on-primary">
            <svg slot="leading-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            Send Email Inquiry
          </M3Button>
        </div>
      </div>
    </M3Card>
  </section>
</Layout>
