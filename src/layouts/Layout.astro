---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import EditorialHeader from "../components/editorial/EditorialHeader.astro";
import { PROFILE_INFO } from "../data/projects";

interface Props {
  title?: string;
  description?: string;
  currentRoute?: "/" | "/lab" | "/services";
}

const {
  title = `${PROFILE_INFO.name} (@${PROFILE_INFO.handle}) — ${PROFILE_INFO.title}`,
  description = PROFILE_INFO.tagline,
  currentRoute = "/"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={PROFILE_INFO.name} />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#090d16" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={`${PROFILE_INFO.name} Portfolio`} />

    <!-- Self-Hosted Variable Fonts Preload (Zero External Render-Blocking CSS) -->
    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}fonts/plus-jakarta-sans-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}fonts/jetbrains-mono-latin.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Astro View Transitions -->
    <ClientRouter />

    <!-- Zero-FOUC Instant Theme Initializer (with View Transition persistence) -->
    <script is:inline>
      function applyEditorialTheme() {
        const storedTheme = localStorage.getItem("ed-theme");
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (storedTheme === "dark" || (!storedTheme && systemDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      }
      applyEditorialTheme();
      document.addEventListener("astro:after-swap", applyEditorialTheme);
    </script>
  </head>
  <body class="bg-ed-bg text-ed-text flex flex-col min-h-screen selection:bg-ed-accent-soft selection:text-ed-accent">
    <EditorialHeader currentRoute={currentRoute} />

    <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Editorial Footer -->
    <footer class="mt-auto border-t border-ed-border bg-ed-surface py-8">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3 font-mono text-xs">
            <span class="font-bold text-ed-text">{PROFILE_INFO.name}</span>
            <span class="text-ed-border-strong">/</span>
            <span class="text-ed-accent">@{PROFILE_INFO.handle}</span>
            <span class="text-ed-border-strong hidden sm:inline">/</span>
            <span class="text-ed-text-muted hidden sm:inline">{PROFILE_INFO.location}</span>
          </div>

          <div class="flex flex-wrap items-center gap-5 font-mono text-xs text-ed-text-secondary">
            <a href={import.meta.env.BASE_URL} class="hover:text-ed-accent transition-colors">
              01 // Index
            </a>
            <a href={`${import.meta.env.BASE_URL}lab`} class="hover:text-ed-accent transition-colors">
              02 // Lab [Hobby]
            </a>
            <a
              href={PROFILE_INFO.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-ed-accent transition-colors"
            >
              GitHub ↗
            </a>
            <a
              href={PROFILE_INFO.facebookUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-ed-accent transition-colors"
            >
              Facebook ↗
            </a>
            <a
              href={`mailto:${PROFILE_INFO.email}`}
              class="hover:text-ed-accent transition-colors"
            >
              {PROFILE_INFO.email}
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
