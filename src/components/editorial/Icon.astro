---
interface Props {
  name: "arrow-up-right" | "arrow-down" | "arrow-left" | "chevron-right" | "lock";
  class?: string;
}

const { name, class: className = "w-3.5 h-3.5" } = Astro.props;
---

{name === "arrow-up-right" && (
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`shrink-0 ${className}`}
  >
    <path d="M5 11L11 5" />
    <path d="M6 5h5v5" />
  </svg>
)}

{name === "arrow-down" && (
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`shrink-0 ${className}`}
  >
    <path d="M8 3.5v9" />
    <path d="M4.5 9L8 12.5 11.5 9" />
  </svg>
)}

{name === "arrow-left" && (
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`shrink-0 ${className}`}
  >
    <path d="M12.5 8h-9" />
    <path d="M7 4.5L3.5 8 7 11.5" />
  </svg>
)}

{name === "chevron-right" && (
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`shrink-0 ${className}`}
  >
    <path d="M6 4l4 4-4 4" />
  </svg>
)}

{name === "lock" && (
  <svg
    aria-hidden="true"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={`shrink-0 ${className}`}
  >
    <rect x="3" y="7" width="10" height="7" rx="1.5" />
    <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" />
  </svg>
)}
