---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<button
  id="theme-toggle"
  type="button"
  class={`p-2.5 rounded-m3-full text-m3-on-surface-variant hover:text-m3-on-surface hover:bg-m3-surface-container active:bg-m3-surface-container-high transition-colors cursor-pointer select-none m3-state-layer ${className}`}
  aria-label="Toggle color theme"
  title="Toggle dark / light theme"
>
  <!-- Sun Icon (shown in dark mode) -->
  <svg
    id="theme-toggle-light-icon"
    class="w-5 h-5 hidden"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    />
  </svg>
  <!-- Moon Icon (shown in light mode) -->
  <svg
    id="theme-toggle-dark-icon"
    class="w-5 h-5 hidden"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    />
  </svg>
</button>

<script is:inline>
  function initTheme() {
    const lightIcon = document.getElementById("theme-toggle-light-icon");
    const darkIcon = document.getElementById("theme-toggle-dark-icon");
    const toggleBtn = document.getElementById("theme-toggle");

    if (!lightIcon || !darkIcon || !toggleBtn) return;

    const isDark = document.documentElement.classList.contains("dark");
    if (isDark) {
      lightIcon.classList.remove("hidden");
      darkIcon.classList.add("hidden");
    } else {
      darkIcon.classList.remove("hidden");
      lightIcon.classList.add("hidden");
    }

    // Attach click handler once
    if (!toggleBtn.dataset.bound) {
      toggleBtn.dataset.bound = "true";
      toggleBtn.addEventListener("click", () => {
        const currentlyDark = document.documentElement.classList.contains("dark");
        if (currentlyDark) {
          document.documentElement.classList.remove("dark");
          localStorage.setItem("m3-theme", "light");
          lightIcon.classList.add("hidden");
          darkIcon.classList.remove("hidden");
        } else {
          document.documentElement.classList.add("dark");
          localStorage.setItem("m3-theme", "dark");
          darkIcon.classList.add("hidden");
          lightIcon.classList.remove("hidden");
        }
      });
    }
  }

  // Run on first load and on view transitions if any
  initTheme();
  document.addEventListener("astro:page-load", initTheme);
</script>
