---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<button
  id="theme-toggle"
  type="button"
  class={`m3-btn-expressive inline-flex items-center justify-center w-8 h-8 rounded-full border border-ed-border bg-ed-surface-subtle/70 text-ed-text-secondary hover:text-ed-text hover:bg-ed-surface-muted/70 hover:border-ed-border-strong cursor-pointer select-none ${className}`}
  aria-label="Toggle color theme"
  title="Toggle dark / light theme"
>
  <!-- Sun Icon (shown in dark mode) -->
  <svg
    id="theme-toggle-light-icon"
    class="w-4 h-4 hidden"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.75"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    />
  </svg>
  <!-- Moon Icon (shown in light mode) -->
  <svg
    id="theme-toggle-dark-icon"
    class="w-4 h-4 hidden"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.75"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
    />
  </svg>
</button>

<script is:inline>
  function syncThemeToggle() {
    const lightIcon = document.getElementById("theme-toggle-light-icon");
    const darkIcon = document.getElementById("theme-toggle-dark-icon");
    const toggleBtn = document.getElementById("theme-toggle");

    if (!lightIcon || !darkIcon || !toggleBtn) return;

    const isDark = document.documentElement.classList.contains("dark");
    if (isDark) {
      lightIcon.classList.remove("hidden");
      darkIcon.classList.add("hidden");
    } else {
      darkIcon.classList.remove("hidden");
      lightIcon.classList.add("hidden");
    }

    if (!toggleBtn.dataset.bound) {
      toggleBtn.dataset.bound = "true";
      toggleBtn.addEventListener("click", () => {
        const currentlyDark = document.documentElement.classList.contains("dark");
        if (currentlyDark) {
          document.documentElement.classList.remove("dark");
          localStorage.setItem("ed-theme", "light");
          lightIcon.classList.add("hidden");
          darkIcon.classList.remove("hidden");
        } else {
          document.documentElement.classList.add("dark");
          localStorage.setItem("ed-theme", "dark");
          darkIcon.classList.add("hidden");
          lightIcon.classList.remove("hidden");
        }
      });
    }
  }

  syncThemeToggle();
  document.addEventListener("astro:page-load", syncThemeToggle);
</script>
