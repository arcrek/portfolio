---
import type { ArchitectureFlow } from "../../data/projects";

interface Props {
  diagramId: string;
  flow: ArchitectureFlow;
}

const { diagramId, flow } = Astro.props;
const nodes = flow.nodes;
const firstNode = nodes[0];

// Compute horizontal SVG coordinates for up to 5 pipeline stages (viewBox 0 0 900 116)
const nodeWidth = 148;
const nodeHeight = 68;
const gap = 30;
const startX = 18;
const startY = 24;
---

<div
  class="ed-arch-diagram rounded-2xl overflow-hidden border border-ed-border bg-ed-surface"
  data-diagram-root={diagramId}
>
  <!-- Diagram Header Bar -->
  <div class="px-4 py-2.5 border-b border-ed-border bg-ed-surface-subtle/60 flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-ed-accent"></span>
      <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-ed-text">
        {flow.title}
      </span>
    </div>
    <span class="font-mono text-[11px] text-ed-text-muted">
      {flow.summary}
    </span>
  </div>

  <!-- Interactive SVG Canvas -->
  <div class="ed-diagram-surface px-3 py-4 overflow-x-auto">
    <svg
      viewBox="0 0 900 116"
      width="900"
      height="116"
      class="w-full min-w-[680px] h-auto block select-none"
      role="img"
      aria-label={flow.title}
    >
      <defs>
        <marker
          id={`arrow-${diagramId}`}
          viewBox="0 0 10 10"
          refX="7"
          refY="5"
          markerWidth="5"
          markerHeight="5"
          orient="auto-start-reverse"
        >
          <path d="M 0 1 L 8 5 L 0 9 z" fill="var(--ed-accent)" />
        </marker>
      </defs>

      <!-- Animated Flow Connectors between Nodes -->
      {nodes.slice(0, -1).map((_, idx) => {
        const x1 = startX + idx * (nodeWidth + gap) + nodeWidth;
        const x2 = startX + (idx + 1) * (nodeWidth + gap);
        const y = startY + nodeHeight / 2;
        return (
          <g>
            <line
              x1={x1}
              y1={y}
              x2={x2}
              y2={y}
              stroke="var(--ed-border-strong)"
              stroke-width="1.5"
            />
            <line
              x1={x1}
              y1={y}
              x2={x2 - 3}
              y2={y}
              stroke="var(--ed-accent)"
              stroke-width="1.75"
              class="ed-flow-line"
              marker-end={`url(#arrow-${diagramId})`}
            />
          </g>
        );
      })}

      <!-- Interactive Pipeline Stage Nodes -->
      {nodes.map((node, idx) => {
        const x = startX + idx * (nodeWidth + gap);
        const y = startY;
        const isFirst = idx === 0;
        return (
          <g
            class="ed-arch-node cursor-pointer focus:outline-none"
            tabindex="0"
            role="button"
            aria-pressed={isFirst ? "true" : "false"}
            aria-label={`Stage ${node.step}: ${node.label} (${node.protocol})`}
            data-node-x={x + nodeWidth / 2}
          >
            <!-- Node Box -->
            <rect
              class="ed-node-rect transition-colors duration-150"
              x={x}
              y={y}
              width={nodeWidth}
              height={nodeHeight}
              rx="12"
              fill={isFirst ? "var(--ed-accent-soft)" : "var(--ed-surface)"}
              stroke={isFirst ? "var(--ed-accent)" : "var(--ed-border-strong)"}
              stroke-width={isFirst ? "1.75" : "1"}
            />

            <!-- Step Number Badge -->
            <text
              x={x + 12}
              y={y + 19}
              fill="var(--ed-accent)"
              font-family="var(--font-mono)"
              font-size="10"
              font-weight="600"
            >
              [{node.step}]
            </text>

            <!-- Protocol Tag -->
            <text
              x={x + nodeWidth - 12}
              y={y + 19}
              text-anchor="end"
              fill="var(--ed-text-muted)"
              font-family="var(--font-mono)"
              font-size="9.5"
            >
              {node.protocol}
            </text>

            <!-- Divider Line inside Node -->
            <line
              x1={x + 12}
              y1={y + 27}
              x2={x + nodeWidth - 12}
              y2={y + 27}
              stroke="var(--ed-border)"
              stroke-width="1"
            />

            <!-- Node Primary Title -->
            <text
              x={x + 12}
              y={y + 49}
              fill="var(--ed-text)"
              font-family="var(--font-mono)"
              font-size="12"
              font-weight="600"
            >
              {node.label}
            </text>
          </g>
        );
      })}
    </svg>
  </div>

  <!-- Interactive Stage Inspection Readout -->
  {firstNode && (
    <div class="px-3.5 sm:px-4 py-3 border-t border-ed-border bg-ed-surface flex flex-col gap-2.5">
      <!-- Controls & Metadata Header: Stage Badge on Left, Quick Step Pills on Right -->
      <div class="flex flex-wrap items-center justify-between gap-2 min-w-0">
        <span
          class="ed-inspector-badge rounded-full font-mono text-[10px] sm:text-[11px] font-semibold px-2 sm:px-2.5 py-0.5 bg-ed-accent-soft text-ed-accent border border-ed-accent-border whitespace-nowrap shrink-0 max-w-full truncate"
          data-inspector-badge
        >
          STAGE {firstNode.step} · {firstNode.protocol}
        </span>

        <!-- Quick Step Selector Pills -->
        <div class="flex items-center gap-1 shrink-0" role="group" aria-label="Stage selector">
          {nodes.map((node, idx) => (
            <button
              type="button"
              class={`ed-step-pill m3-btn-expressive rounded-full font-mono text-[9.5px] sm:text-[10.5px] min-w-[22px] sm:min-w-[26px] h-5.5 sm:h-6 px-1 sm:px-1.5 border inline-flex items-center justify-center cursor-pointer transition-colors ${
                idx === 0
                  ? "border-ed-accent bg-ed-accent-soft text-ed-accent font-semibold"
                  : "border-ed-border bg-ed-surface-subtle/60 text-ed-text-muted hover:text-ed-text hover:bg-ed-surface-muted/60"
              }`}
              data-step-trigger={idx}
              data-step={node.step}
              data-protocol={node.protocol}
              aria-pressed={idx === 0 ? "true" : "false"}
              aria-label={`Inspect stage ${node.step}: ${node.label}`}
            >
              {node.step}
            </button>
          ))}
        </div>
      </div>

      <!-- Detail Body: Full Width Stage Label and Description -->
      <div class="grid w-full min-w-0" aria-live="polite">
        {nodes.map((node, idx) => {
          const isFirst = idx === 0;
          return (
            <div
              class={`col-start-1 row-start-1 min-w-0 transition-opacity duration-150 ${
                isFirst
                  ? "opacity-100 visible"
                  : "opacity-0 invisible pointer-events-none select-none"
              }`}
              data-inspector-panel={idx}
              aria-hidden={isFirst ? "false" : "true"}
            >
              <p class="text-xs leading-relaxed text-ed-text-secondary min-w-0 break-words">
                <span class="font-mono font-semibold text-ed-text mr-1.5">
                  {node.label}:
                </span>
                <span>{node.detail}</span>
              </p>
            </div>
          );
        })}
      </div>
    </div>
  )}
</div>

<style>
  .ed-arch-node:focus-visible {
    outline: none;
  }
  .ed-arch-node:focus-visible .ed-node-rect {
    stroke: var(--ed-accent) !important;
    stroke-width: 2.25px !important;
    filter: drop-shadow(0 0 3px var(--ed-accent));
  }
  .ed-step-pill:focus-visible {
    outline: 2px solid var(--ed-accent);
    outline-offset: 1px;
  }
</style>

<script is:inline>
  function initArchitectureDiagrams() {
    const roots = document.querySelectorAll("[data-diagram-root]");
    roots.forEach((root) => {
      if (root.dataset.bound === "true") return;
      root.dataset.bound = "true";

      const surface = root.querySelector(".ed-diagram-surface");
      const nodes = root.querySelectorAll(".ed-arch-node");
      const pills = root.querySelectorAll("[data-step-trigger]");
      const badge = root.querySelector("[data-inspector-badge]");
      const panels = root.querySelectorAll("[data-inspector-panel]");

      function activateIndex(activeIndex, options = {}) {
        nodes.forEach((node, idx) => {
          const rect = node.querySelector(".ed-node-rect");
          const isActive = idx === activeIndex;
          node.setAttribute("aria-pressed", isActive ? "true" : "false");
          if (rect) {
            rect.setAttribute(
              "fill",
              isActive ? "var(--ed-accent-soft)" : "var(--ed-surface)"
            );
            rect.setAttribute(
              "stroke",
              isActive ? "var(--ed-accent)" : "var(--ed-border-strong)"
            );
            rect.setAttribute("stroke-width", isActive ? "1.75" : "1");
          }
        });

        if (badge && pills[activeIndex]) {
          const p = pills[activeIndex];
          badge.textContent = `STAGE ${p.dataset.step} · ${p.dataset.protocol}`;
        }

        panels.forEach((panel, idx) => {
          const isActive = idx === activeIndex;
          panel.classList.toggle("opacity-100", isActive);
          panel.classList.toggle("visible", isActive);
          panel.classList.toggle("opacity-0", !isActive);
          panel.classList.toggle("invisible", !isActive);
          panel.classList.toggle("pointer-events-none", !isActive);
          panel.classList.toggle("select-none", !isActive);
          panel.setAttribute("aria-hidden", isActive ? "false" : "true");
        });

        pills.forEach((pill, idx) => {
          const isActive = idx === activeIndex;
          pill.setAttribute("aria-pressed", isActive ? "true" : "false");
          pill.classList.toggle("border-ed-accent", isActive);
          pill.classList.toggle("bg-ed-accent-soft", isActive);
          pill.classList.toggle("text-ed-accent", isActive);
          pill.classList.toggle("font-semibold", isActive);

          pill.classList.toggle("border-ed-border", !isActive);
          pill.classList.toggle("bg-ed-surface-subtle/60", !isActive);
          pill.classList.toggle("text-ed-text-muted", !isActive);
        });

        // Smooth scroll diagram canvas to active node on mobile/scrollable viewports
        if (options.scroll !== false && surface && surface.scrollWidth > surface.clientWidth) {
          const activeNode = nodes[activeIndex];
          if (activeNode) {
            const nodeCenterX = parseFloat(activeNode.dataset.nodeX || "0");
            if (nodeCenterX > 0) {
              const svgEl = surface.querySelector("svg");
              const svgWidth = svgEl ? (svgEl.clientWidth || svgEl.getBoundingClientRect().width) : 900;
              const scale = svgWidth / 900;
              const targetLeft = nodeCenterX * scale - surface.clientWidth / 2;
              const isReducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
              surface.scrollTo({
                left: Math.max(0, targetLeft),
                behavior: isReducedMotion ? "auto" : "smooth"
              });
            }
          }
        }
      }

      nodes.forEach((node, idx) => {
        node.addEventListener("mouseenter", () => activateIndex(idx, { scroll: false }));
        node.addEventListener("click", () => activateIndex(idx));
        node.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            activateIndex(idx);
          }
        });
      });

      pills.forEach((pill, idx) => {
        pill.addEventListener("click", () => activateIndex(idx));
      });
    });
  }

  initArchitectureDiagrams();
  if (!window.__edArchDiagramBound) {
    window.__edArchDiagramBound = true;
    document.addEventListener("astro:page-load", initArchitectureDiagrams);
  }
</script>
