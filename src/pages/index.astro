---
import Layout from "../layouts/Layout.astro";
import FlagshipCard from "../components/editorial/FlagshipCard.astro";
import ProjectRow from "../components/editorial/ProjectRow.astro";
import { CURATED_PROJECTS, PROFILE_INFO } from "../data/projects";
import { fetchAllCuratedRepos } from "../lib/github";

// Build-time GitHub data hydration
const repoSlugs = CURATED_PROJECTS.map((p) => p.repoSlug);
const githubMetaMap = await fetchAllCuratedRepos(repoSlugs);

const flagshipProjects = CURATED_PROJECTS.filter((p) => p.tier === "flagship");
const indexProjects = CURATED_PROJECTS.filter((p) => p.tier === "index");
---

<Layout currentRoute="/">
  <!-- 01 // EDITORIAL MASTHEAD & INTEGRATED STACK STRIP -->
  <section aria-labelledby="masthead-heading" class="mb-12">
    <div class="rounded-3xl overflow-hidden shadow-xs border border-ed-border bg-ed-surface">
      <!-- Top Row: Identity & Profile Telemetry -->
      <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-ed-border">
        <!-- Main Narrative (8 cols) -->
        <div class="lg:col-span-8 p-6 sm:p-8 flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="inline-flex items-center gap-2 rounded-full px-3 py-1 border border-ed-border bg-ed-surface-subtle font-mono text-xs text-ed-text-secondary">
              <span class="w-2 h-2 rounded-full bg-ed-status animate-pulse"></span>
              <span>01 // IDENTITY</span>
              <span class="text-ed-border-strong">&bull;</span>
              <span>{PROFILE_INFO.stats.status}</span>
            </div>

            <h1
              id="masthead-heading"
              class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ed-text leading-[1.1]"
            >
              {PROFILE_INFO.name}
              <span class="block sm:inline font-mono text-xl sm:text-3xl font-semibold text-ed-accent sm:ml-2">
                @{PROFILE_INFO.handle}
              </span>
            </h1>

            <p class="text-base sm:text-lg text-ed-text-secondary leading-relaxed max-w-2xl">
              {PROFILE_INFO.tagline} If a workflow can be containerized, piped over sockets, or scripted headless, I have probably stayed up until 3 a.m. making it run in production.
            </p>
          </div>

          <!-- Primary Actions -->
          <div class="flex flex-wrap items-center gap-2.5 pt-2">
            <a
              href="#flagship-systems"
              class="m3-btn-expressive rounded-full inline-flex items-center gap-2 px-4 py-2 bg-ed-text text-ed-bg font-mono text-xs font-semibold hover:opacity-90"
            >
              <span>Inspect Flagship Systems</span>
              <span>↓</span>
            </a>

            <a
              href="#engineering-index"
              class="m3-btn-expressive rounded-full inline-flex items-center gap-2 px-4 py-2 border border-ed-border bg-ed-surface-subtle text-ed-text font-mono text-xs font-medium hover:bg-ed-surface-muted/70 hover:border-ed-border-strong"
            >
              <span>All Projects ({CURATED_PROJECTS.length})</span>
            </a>

            <a
              href={PROFILE_INFO.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="m3-btn-expressive rounded-full inline-flex items-center gap-1.5 px-4 py-2 border border-ed-border bg-ed-surface text-ed-text-secondary hover:text-ed-text hover:bg-ed-surface-subtle hover:border-ed-border-strong font-mono text-xs"
            >
              <span>GitHub ({PROFILE_INFO.stats.publicRepos} repos)</span>
              <span>↗</span>
            </a>

            <a
              href={`mailto:${PROFILE_INFO.email}`}
              class="m3-btn-expressive rounded-full inline-flex items-center gap-1.5 px-4 py-2 border border-ed-border bg-ed-surface text-ed-text-secondary hover:text-ed-text hover:bg-ed-surface-subtle hover:border-ed-border-strong font-mono text-xs"
            >
              <span>{PROFILE_INFO.email}</span>
            </a>
          </div>
        </div>

        <!-- Profile Column (4 cols) -->
        <div class="lg:col-span-4 p-6 bg-ed-surface-subtle/40 flex flex-col justify-between gap-5">
          <div class="flex items-center gap-4">
            <div class="relative w-20 h-20 rounded-2xl border border-ed-border-strong bg-ed-surface shrink-0 overflow-hidden">
              <img
                src={`${import.meta.env.BASE_URL}img.jpg`}
                alt={PROFILE_INFO.name}
                width="80"
                height="80"
                decoding="async"
                fetchpriority="high"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="space-y-1 min-w-0">
              <div class="font-mono text-xs font-bold uppercase tracking-wider text-ed-accent">
                Builder Telemetry
              </div>
              <div class="font-bold text-sm text-ed-text truncate">
                {PROFILE_INFO.title}
              </div>
              <div class="font-mono text-xs text-ed-text-muted">
                Based in {PROFILE_INFO.location}
              </div>
            </div>
          </div>

          <div class="grid grid-cols-2 rounded-2xl overflow-hidden border border-ed-border bg-ed-surface divide-x divide-ed-border">
            <div class="p-3">
              <div class="font-mono text-lg font-extrabold text-ed-text">
                {PROFILE_INFO.stats.publicRepos}
              </div>
              <div class="font-mono text-[10px] uppercase tracking-wider text-ed-text-muted">
                Public Repos
              </div>
            </div>
            <div class="p-3">
              <div class="font-mono text-lg font-extrabold text-ed-accent">
                Backend
              </div>
              <div class="font-mono text-[10px] uppercase tracking-wider text-ed-text-muted">
                Primary Focus
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-ed-border flex items-center justify-between font-mono text-[11px] text-ed-text-muted">
            <span>"{PROFILE_INFO.stats.motto}"</span>
            <span class="text-ed-status font-semibold">● ONLINE</span>
          </div>
        </div>
      </div>

      <!-- Bottom Row: Integrated Technical Stack Strip -->
      <div class="border-t border-ed-border grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-ed-border bg-ed-surface">
        <div class="p-4 sm:px-6 space-y-2">
          <div class="font-mono text-[10px] font-semibold uppercase tracking-wider text-ed-text-muted">
            Languages
          </div>
          <div class="flex flex-wrap gap-1.5">
            {PROFILE_INFO.skills.languages.map((lang) => (
              <span class="rounded-lg font-mono text-xs px-2.5 py-0.5 border border-ed-border bg-ed-surface-subtle text-ed-text">
                {lang}
              </span>
            ))}
          </div>
        </div>

        <div class="p-4 sm:px-6 space-y-2">
          <div class="font-mono text-[10px] font-semibold uppercase tracking-wider text-ed-text-muted">
            Frameworks & Runtime
          </div>
          <div class="flex flex-wrap gap-1.5">
            {PROFILE_INFO.skills.frameworks.map((fw) => (
              <span class="rounded-lg font-mono text-xs px-2.5 py-0.5 border border-ed-border bg-ed-surface-subtle text-ed-text">
                {fw}
              </span>
            ))}
          </div>
        </div>

        <div class="p-4 sm:px-6 space-y-2">
          <div class="font-mono text-[10px] font-semibold uppercase tracking-wider text-ed-text-muted">
            Infrastructure & Protocols
          </div>
          <div class="flex flex-wrap gap-1.5">
            {PROFILE_INFO.skills.infrastructure.map((infra) => (
              <span class="rounded-lg font-mono text-xs px-2.5 py-0.5 border border-ed-border bg-ed-surface-subtle text-ed-text">
                {infra}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 // FLAGSHIP PRODUCTION SYSTEMS -->
  <section id="flagship-systems" class="mb-14 scroll-mt-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-5 pb-3 border-b border-ed-border">
      <div>
        <div class="font-mono text-xs font-semibold uppercase tracking-wider text-ed-accent">
          02 // Flagship Production Systems
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ed-text mt-1">
          Core Architecture & Builds
        </h2>
      </div>
      <div class="flex items-center gap-2 font-mono text-xs text-ed-text-muted">
        <span class="w-2 h-2 rounded-full bg-ed-status"></span>
        <span>Interactive SVG Pipeline &bull; Live GitHub Hydration</span>
      </div>
    </div>

    <div class="space-y-8">
      {flagshipProjects.map((project) => (
        <FlagshipCard
          project={project}
          ghMeta={githubMetaMap[project.repoSlug]}
        />
      ))}
    </div>
  </section>

  <!-- 03 // EXPANDABLE ENGINEERING INDEX -->
  <section id="engineering-index" class="mb-14 scroll-mt-20">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-4">
      <div>
        <div class="font-mono text-xs font-semibold uppercase tracking-wider text-ed-accent">
          03 // Engineering Index
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight text-ed-text mt-1">
          Additional Systems, Daemons & Tooling
        </h2>
        <p class="text-xs sm:text-sm text-ed-text-secondary mt-0.5">
          Click any row to expand problem context, system mechanics, and technical highlights inline.
        </p>
      </div>

      <a
        href={PROFILE_INFO.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-ed-accent hover:underline shrink-0"
      >
        <span>Browse all {PROFILE_INFO.stats.publicRepos} repositories on GitHub</span>
        <span>↗</span>
      </a>
    </div>

    <div class="rounded-3xl overflow-hidden shadow-xs border border-ed-border bg-ed-surface">
      {indexProjects.map((project) => (
        <ProjectRow
          project={project}
          ghMeta={githubMetaMap[project.repoSlug]}
        />
      ))}
    </div>
  </section>

  <!-- 04 // DIRECT CONTACT STRIP -->
  <section aria-labelledby="contact-heading">
    <div class="rounded-3xl overflow-hidden shadow-xs border border-ed-border bg-ed-surface p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-1.5 max-w-xl">
        <div class="font-mono text-xs font-semibold uppercase tracking-wider text-ed-accent">
          04 // Dispatch & Contact
        </div>
        <h2 id="contact-heading" class="text-xl sm:text-2xl font-bold text-ed-text">
          Open to software engineering internships and backend systems work.
        </h2>
        <p class="text-xs sm:text-sm text-ed-text-secondary leading-relaxed">
          Have a question about one of my repositories, or looking for an ICT student who ships real backend infrastructure? Reach out directly via email or GitHub.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 shrink-0">
        <a
          href={`mailto:${PROFILE_INFO.email}`}
          class="m3-btn-expressive rounded-full inline-flex items-center gap-2 px-4 py-2 bg-ed-text text-ed-bg font-mono text-xs font-semibold hover:opacity-90"
        >
          <span>Send Email</span>
          <span>↗</span>
        </a>

        <a
          href={PROFILE_INFO.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="m3-btn-expressive rounded-full inline-flex items-center gap-1.5 px-4 py-2 border border-ed-border bg-ed-surface-subtle text-ed-text font-mono text-xs font-medium hover:bg-ed-surface-muted/70 hover:border-ed-border-strong"
        >
          <span>GitHub (@{PROFILE_INFO.handle})</span>
          <span>↗</span>
        </a>

        <a
          href={PROFILE_INFO.facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="m3-btn-expressive rounded-full inline-flex items-center gap-1.5 px-4 py-2 border border-ed-border bg-ed-surface text-ed-text-secondary hover:text-ed-text hover:bg-ed-surface-subtle font-mono text-xs"
        >
          <span>Facebook</span>
          <span>↗</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
